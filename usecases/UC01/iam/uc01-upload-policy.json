{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListOnlyLandingPrefix",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": "arn:aws:s3:::REPLACE_WITH_BUCKET_NAME",
      "Condition": {
        "StringLike": {
          "s3:prefix": ["landing/loan_demo", "landing/loan_demo/*"]
        }
      }
    },
    {
      "Sid": "UploadOnlyToLandingPrefix",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:AbortMultipartUpload"],
      "Resource": "arn:aws:s3:::REPLACE_WITH_BUCKET_NAME/landing/loan_demo/*"
    }
  ]
}
